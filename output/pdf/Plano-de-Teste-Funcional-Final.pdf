BT 1 0 0 1 36 463.5 Tm /F3 6.2 Tf 7.7 TL (CREATE TABLE ats_cliente \() Tj T* (  cliente_id NUMBER GENERATED BY DEFAULT AS IDENTITY,) Tj T* (  nome VARCHAR2\(100\) NOT NULL,) Tj T* (  email VARCHAR2\(150\) NOT NULL,) Tj T* (  telefone VARCHAR2\(11\),) Tj T* (  data_nascimento DATE NOT NULL,) Tj T* (  status_cliente CHAR\(1\) DEFAULT 'A' NOT NULL,) Tj T* (  CONSTRAINT pk_ats_cliente PRIMARY KEY \(cliente_id\),) Tj T* (  CONSTRAINT uk_ats_cliente_email UNIQUE \(email\),) Tj T* (  CONSTRAINT ck_ats_cliente_nome CHECK \(LENGTH\(TRIM\(nome\)\) BETWEEN 3 AND 100\),) Tj T* (  CONSTRAINT ck_ats_cliente_email CHECK \(REGEXP_LIKE\(email, '^[^@ ]+@[^@ ]+[.][^@ ]+$'\)\),) Tj T* (  CONSTRAINT ck_ats_cliente_tel CHECK \(telefone IS NULL OR REGEXP_LIKE\(telefone, '^[0-9]{10,11}$'\)\),) Tj T* (  CONSTRAINT ck_ats_cliente_nasc CHECK \(data_nascimento BETWEEN DATE '1900-01-01' AND DATE '2008-09-26'\),) Tj T* (  CONSTRAINT ck_ats_cliente_status CHECK \(status_cliente IN \('A', 'I'\)\)) Tj T* (\);) Tj T*  T* (CREATE TABLE ats_endereco \() Tj T* (  endereco_id NUMBER GENERATED BY DEFAULT AS IDENTITY,) Tj T* (  cliente_id NUMBER NOT NULL,) Tj T* (  tipo_endereco VARCHAR2\(12\) NOT NULL,) Tj T* (  logradouro VARCHAR2\(150\) NOT NULL,) Tj T* (  numero NUMBER\(6\) NOT NULL,) Tj T* (  complemento VARCHAR2\(60\),) Tj T* (  cep CHAR\(8\) NOT NULL,) Tj T* (  cidade VARCHAR2\(80\) NOT NULL,) Tj T* (  uf CHAR\(2\) NOT NULL,) Tj T* (  CONSTRAINT pk_ats_endereco PRIMARY KEY \(endereco_id\),) Tj T* (  CONSTRAINT uk_ats_endereco_cli UNIQUE \(endereco_id, cliente_id\),) Tj T* (  CONSTRAINT fk_ats_endereco_cliente FOREIGN KEY \(cliente_id\) REFERENCES ats_cliente \(cliente_id\),) Tj T* (  CONSTRAINT ck_ats_endereco_tipo CHECK \(tipo_endereco IN \('RESIDENCIAL', 'COMERCIAL'\)\),) Tj T* (  CONSTRAINT ck_ats_endereco_logr CHECK \(LENGTH\(TRIM\(logradouro\)\) BETWEEN 3 AND 150\),) Tj T* (  CONSTRAINT ck_ats_endereco_num CHECK \(numero BETWEEN 1 AND 999999 AND numero = TRUNC\(numero\)\),) Tj T* (  CONSTRAINT ck_ats_endereco_cep CHECK \(REGEXP_LIKE\(cep, '^[0-9]{8}$'\)\),) Tj T* (  CONSTRAINT ck_ats_endereco_uf CHECK \(REGEXP_LIKE\(uf, '^[A-Z]{2}$'\)\)) Tj T* (\);) Tj T*  T* (CREATE TABLE ats_categoria \() Tj T* (  categoria_id NUMBER GENERATED BY DEFAULT AS IDENTITY,) Tj T* (  nome VARCHAR2\(80\) NOT NULL,) Tj T* (  descricao VARCHAR2\(250\),) Tj T* (  ativo CHAR\(1\) DEFAULT 'S' NOT NULL,) Tj T* (  CONSTRAINT pk_ats_categoria PRIMARY KEY \(categoria_id\),) Tj T* (  CONSTRAINT uk_ats_categoria_nome UNIQUE \(nome\),) Tj T* (  CONSTRAINT ck_ats_categoria_nome CHECK \(LENGTH\(TRIM\(nome\)\) BETWEEN 3 AND 80\),) Tj T* (  CONSTRAINT ck_ats_categoria_ativo CHECK \(ativo IN \('S', 'N'\)\)) Tj T* (\);) Tj T*  T* (CREATE TABLE ats_produto \() Tj T* (  produto_id NUMBER GENERATED BY DEFAULT AS IDENTITY,) Tj T* (  categoria_id NUMBER NOT NULL,) Tj T* (  sku VARCHAR2\(20\) NOT NULL,) Tj T* (  nome VARCHAR2\(120\) NOT NULL,) Tj T* (  preco NUMBER\(12,2\) NOT NULL,) Tj T* (  estoque NUMBER\(8\) DEFAULT 0 NOT NULL,) Tj T* (  ativo CHAR\(1\) DEFAULT 'S' NOT NULL,) Tj T* (  CONSTRAINT pk_ats_produto PRIMARY KEY \(produto_id\),) Tj T* (  CONSTRAINT uk_ats_produto_sku UNIQUE \(sku\),) Tj T* (  CONSTRAINT fk_ats_produto_categoria FOREIGN KEY \(categoria_id\) REFERENCES ats_categoria \(categoria_id\),) Tj T* (  CONSTRAINT ck_ats_produto_nome CHECK \(LENGTH\(TRIM\(nome\)\) BETWEEN 3 AND 120\),) Tj T* (  CONSTRAINT ck_ats_produto_preco CHECK \(preco BETWEEN 0.01 AND 999999.99\),) Tj T* (  CONSTRAINT ck_ats_produto_estoque CHECK \(estoque BETWEEN 0 AND 99999999 AND estoque = TRUNC\(estoque\)\),) Tj T* ET
