rega IN \('PREPARANDO', 'ENVIADO', 'ENTREGUE', 'DEVOLVIDO'\)\),) Tj T* (  CONSTRAINT ck_ats_entrega_prev CHECK \(data_prevista IS NULL OR data_envio IS NULL OR data_prevista >=) Tj T* (    data_envio\),) Tj T* (  CONSTRAINT ck_ats_entrega_data CHECK \(data_entrega IS NULL OR \(data_envio IS NOT NULL AND data_entrega >=) Tj T* (    data_envio\)\),) Tj T* (  CONSTRAINT ck_ats_entrega_concl CHECK \(status_entrega <> 'ENTREGUE' OR data_entrega IS NOT NULL\)) Tj T* (\);) Tj T* ET
